rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function currentUser() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? get(userPath(request.auth.uid)).data
        : {};
    }

    function isAdmin() {
      return signedIn() && currentUser().role == "admin";
    }

    function isCoach() {
      return signedIn() && (
        currentUser().role == "coach" ||
        currentUser().role == "admin"
      );
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function publicProgram(data) {
      return data.isActive != false && (
        data.visibility == "public" ||
        data.origine == "premium" ||
        data.source == "premium" ||
        data.isPremiumOnly == true
      );
    }

    function userSelfProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "role",
        "hasActiveSubscription",
        "subscriptionStatus",
        "stripeCustomerId",
        "stripeSubscriptionId",
        "trialStartedAt",
        "trialEndsAt",
        "linkedClientId"
      ]);
    }

    match /users/{uid} {
      allow create: if isOwnUser(uid) || isAdmin() || isCoach();
      allow get: if isOwnUser(uid) || isAdmin() || isCoach() || (signedIn() && resource.data.role in ["coach", "admin"]);
      allow list: if isAdmin() || isCoach();
      allow update: if isAdmin() || isCoach() || (isOwnUser(uid) && userSelfProtectedFieldsUnchanged());
      allow delete: if isAdmin();

      match /privacy/{document=**} {
        allow read, write: if isOwnUser(uid) || isAdmin();
      }

      match /measurements/{document=**} {
        allow read, write: if isOwnUser(uid) || isAdmin() || isCoach();
      }
    }

    match /clients/{clientId} {
      allow read, write: if signedIn();

      match /{subCollection}/{document=**} {
        allow read, write: if signedIn();
      }
    }

    match /programmes/{programId} {
      allow read: if publicProgram(resource.data) || signedIn();
      allow write: if signedIn();

      match /{subCollection}/{document=**} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }

    match /sessions/{sessionId} {
      allow read, write: if signedIn();
    }

    match /training/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /warmup/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /cooldown/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ergometre/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /coachs/{coachId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isOwnUser(coachId);
    }

    match /analytics_geo/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_daily/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_geo_daily/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_geo_hourly/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /contact_messages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /calendarSubscriptionTokens/{token} {
      allow read, write: if isAdmin();
    }

    match /coachCalendarSubscriptions/{coachId} {
      allow read, write: if isAdmin() || isOwnUser(coachId);
    }

    match /custom_program_orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /stripe_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /health/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
