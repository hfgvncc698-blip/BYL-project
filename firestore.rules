rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function currentUser() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? get(userPath(request.auth.uid)).data
        : {};
    }

    function isAdmin() {
      return signedIn() && verifiedEmail() && currentUser().role == "admin";
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function emailAccessReady(user) {
      return !user.keys().hasAny(["emailVerificationRequired"]) ||
        user.emailVerificationRequired != true ||
        verifiedEmail();
    }

    function isCoach() {
      return signedIn() && (
        currentUser().role == "coach" ||
        currentUser().role == "admin"
      );
    }

    function hasCoachAccess() {
      let user = currentUser();
      return isAdmin() || (
        signedIn() &&
        user.role == "coach" &&
        emailAccessReady(user) &&
        (
          user.hasActiveSubscription == true ||
          user.subscriptionStatus == "active" ||
          user.subscriptionStatus == "club_active" ||
          (
            user.subscriptionStatus == "trialing" &&
            user.keys().hasAny(["trialEndsAt"]) &&
            user.trialEndsAt is timestamp &&
            user.trialEndsAt > request.time
          )
        )
      );
    }

    function hasNutritionAccess() {
      let user = currentUser();
      return isAdmin() || (
        hasCoachAccess() && (
          user.subscriptionStatus == "trialing" ||
          (
            user.keys().hasAny(["modules"]) &&
            user.modules is list &&
            ("nutrition" in user.modules || "club" in user.modules)
          ) ||
          (
            user.keys().hasAny(["proAccess"]) &&
            user.proAccess is map &&
            user.proAccess.keys().hasAny(["modules"]) &&
            user.proAccess.modules is list &&
            ("nutrition" in user.proAccess.modules || "club" in user.proAccess.modules)
          ) ||
          (
            user.keys().hasAny(["packageKey"]) &&
            user.packageKey in ["nutrition", "complete", "club"]
          ) ||
          (
            user.keys().hasAny(["proAccess"]) &&
            user.proAccess is map &&
            user.proAccess.keys().hasAny(["packageKey"]) &&
            user.proAccess.packageKey in ["nutrition", "complete", "club"]
          ) ||
          (
            user.keys().hasAny(["nutritionAccess"]) &&
            user.nutritionAccess == true
          ) ||
          (
            user.keys().hasAny(["hasNutritionAccess"]) &&
            user.hasNutritionAccess == true
          ) ||
          (
            user.keys().hasAny(["features"]) &&
            user.features is map &&
            user.features.keys().hasAny(["nutrition"]) &&
            user.features.nutrition == true
          )
        )
      );
    }

    function isClubOwner(clubId) {
      return signedIn() && (
        isAdmin() ||
        (
          currentUser().role == "coach" &&
          currentUser().clubId == clubId &&
          hasCoachAccess() &&
          (
            currentUser().accountType == "club_owner" ||
            currentUser().clubRole == "owner"
          )
        )
      );
    }

    function isOwnUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSameClub(data) {
      return signedIn() &&
        currentUser().keys().hasAny(["clubId"]) &&
        data.keys().hasAny(["clubId"]) &&
        currentUser().clubId == data.clubId;
    }

    function uidInList(data, field) {
      return data.keys().hasAny([field]) &&
        data[field] is list &&
        request.auth.uid in data[field];
    }

    function clientIsOwnProfile(clientId, data) {
      return isOwnUser(clientId) ||
        (data.keys().hasAny(["uid"]) && data.uid == request.auth.uid) ||
        (data.keys().hasAny(["userId"]) && data.userId == request.auth.uid) ||
        (data.keys().hasAny(["linkedUserId"]) && data.linkedUserId == request.auth.uid) ||
        (data.keys().hasAny(["accountUid"]) && data.accountUid == request.auth.uid) ||
        (
          currentUser().keys().hasAny(["linkedClientId"]) &&
          currentUser().linkedClientId == clientId
        );
    }

    function coachOwnsRecord(data) {
      return hasCoachAccess() && (
        (data.keys().hasAny(["createdBy"]) && data.createdBy == request.auth.uid) ||
        (data.keys().hasAny(["coachId"]) && data.coachId == request.auth.uid) ||
        (data.keys().hasAny(["coachUid"]) && data.coachUid == request.auth.uid) ||
        (data.keys().hasAny(["ownerUid"]) && data.ownerUid == request.auth.uid) ||
        (data.keys().hasAny(["assignedBy"]) && data.assignedBy == request.auth.uid) ||
        uidInList(data, "coachIds") ||
        uidInList(data, "sharedWith") ||
        isSameClub(data)
      );
    }

    function canAccessClient(clientId, data) {
      return isAdmin() || clientIsOwnProfile(clientId, data) || coachOwnsRecord(data);
    }

    function canAccessConversation(clientId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/clients/$(clientId)) &&
        canAccessClient(
          clientId,
          get(/databases/$(database)/documents/clients/$(clientId)).data
        );
    }

    function canReadConversation(data) {
      return data.clientId is string &&
        data.participantUids is list &&
        canAccessConversation(data.clientId) &&
        (isAdmin() || request.auth.uid in data.participantUids);
    }

    function conversationClientUidMatches(clientId, clientUid) {
      let client = get(/databases/$(database)/documents/clients/$(clientId)).data;
      return clientUid is string && (
        clientId == clientUid ||
        (client.keys().hasAny(["authUid"]) && client.authUid == clientUid) ||
        (client.keys().hasAny(["accountUid"]) && client.accountUid == clientUid) ||
        (client.keys().hasAny(["linkedUserId"]) && client.linkedUserId == clientUid) ||
        (client.keys().hasAny(["userId"]) && client.userId == clientUid) ||
        (client.keys().hasAny(["uid"]) && client.uid == clientUid)
      );
    }

    function conversationProfessionalMatches(clientId, professionalUid) {
      let client = get(/databases/$(database)/documents/clients/$(clientId)).data;
      return professionalUid is string && (
        (client.keys().hasAny(["createdBy"]) && client.createdBy == professionalUid) ||
        (client.keys().hasAny(["coachId"]) && client.coachId == professionalUid) ||
        (client.keys().hasAny(["coachUid"]) && client.coachUid == professionalUid) ||
        (client.keys().hasAny(["ownerUid"]) && client.ownerUid == professionalUid) ||
        (client.keys().hasAny(["assignedBy"]) && client.assignedBy == professionalUid) ||
        (client.keys().hasAny(["coachIds"]) && client.coachIds is list && professionalUid in client.coachIds) ||
        (client.keys().hasAny(["professionalIds"]) && client.professionalIds is list && professionalUid in client.professionalIds) ||
        (client.keys().hasAny(["nutritionCoachIds"]) && client.nutritionCoachIds is list && professionalUid in client.nutritionCoachIds)
      );
    }

    function validConversationCreate(conversationId, data) {
      return data.keys().hasOnly([
          "clientId", "clientUid", "coachUid", "professionalUid", "participantUids",
          "clientName", "professionalName", "lastMessage", "lastMessageAt",
          "lastMessageAtIso", "lastSenderUid", "updatedAt", "readAtBy"
        ]) &&
        data.keys().hasAll([
          "clientId", "clientUid", "professionalUid", "participantUids", "lastMessage",
          "lastMessageAt", "lastMessageAtIso", "lastSenderUid", "updatedAt", "readAtBy"
        ]) &&
        data.clientId is string &&
        data.clientUid is string &&
        data.professionalUid is string &&
        data.clientUid != data.professionalUid &&
        conversationId == data.clientId + "__" + data.professionalUid &&
        data.participantUids is list &&
        data.participantUids.size() == 2 &&
        data.clientUid in data.participantUids &&
        data.professionalUid in data.participantUids &&
        request.auth.uid in data.participantUids &&
        conversationClientUidMatches(data.clientId, data.clientUid) &&
        conversationProfessionalMatches(data.clientId, data.professionalUid) &&
        (!data.keys().hasAny(["coachUid"]) || data.coachUid == data.professionalUid) &&
        data.lastSenderUid == request.auth.uid &&
        data.lastMessage is string &&
        data.lastMessage.size() <= 180 &&
        data.lastMessageAt == request.time &&
        data.updatedAt == request.time &&
        data.lastMessageAtIso is string &&
        data.readAtBy is map &&
        data.readAtBy.keys().hasOnly([request.auth.uid]) &&
        data.readAtBy[request.auth.uid] == request.time;
    }

    function requesterOnlyChangedOwnReadReceipt(oldData, newData) {
      return !newData.diff(oldData).affectedKeys().hasAny(["readAtBy"]) || (
        newData.readAtBy is map &&
        newData.readAtBy[request.auth.uid] == request.time &&
        (
          (
            oldData.keys().hasAny(["readAtBy"]) &&
            oldData.readAtBy is map &&
            newData.readAtBy.diff(oldData.readAtBy).affectedKeys().hasOnly([request.auth.uid])
          ) ||
          (
            !oldData.keys().hasAny(["readAtBy"]) &&
            newData.readAtBy.keys().hasOnly([request.auth.uid])
          )
        )
      );
    }

    function validConversationUpdate(oldData, newData) {
      let changed = newData.diff(oldData).affectedKeys();
      return canReadConversation(oldData) &&
        newData.clientId == oldData.clientId &&
        newData.clientUid == oldData.clientUid &&
        newData.professionalUid == oldData.professionalUid &&
        (!newData.keys().hasAny(["coachUid"]) || newData.coachUid == newData.professionalUid) &&
        newData.participantUids == oldData.participantUids &&
        newData.participantUids is list &&
        newData.participantUids.size() == 2 &&
        changed.hasOnly([
          "coachUid", "clientName", "professionalName", "lastMessage", "lastMessageAt",
          "lastMessageAtIso", "lastSenderUid", "updatedAt", "readAtBy"
        ]) &&
        requesterOnlyChangedOwnReadReceipt(oldData, newData) &&
        (
          !changed.hasAny(["lastMessage", "lastMessageAt", "lastMessageAtIso", "lastSenderUid"]) ||
          (
            newData.lastSenderUid == request.auth.uid &&
            newData.lastMessage is string &&
            newData.lastMessage.size() <= 180 &&
            newData.lastMessageAt == request.time &&
            newData.updatedAt == request.time &&
            newData.lastMessageAtIso is string &&
            changed.hasAll(["lastMessage", "lastMessageAt", "lastMessageAtIso", "lastSenderUid", "updatedAt"])
          )
        );
    }

    function clientSecurityFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "createdBy",
        "coachId",
        "coachUid",
        "coachIds",
        "ownerId",
        "ownerUid",
        "assignedBy",
        "sharedWith",
        "clubId",
        "clubIds",
        "uid",
        "authUid",
        "userId",
        "linkedUserId",
        "accountUid",
        "role",
        "isAdmin",
        "admin",
        "hasActiveSubscription",
        "subscriptionStatus",
        "stripeCustomerId",
        "stripeSubscriptionId"
      ]);
    }

    function safeSelfClientCreate(clientId, data) {
      return clientIsOwnProfile(clientId, data) &&
        (!data.keys().hasAny(["uid"]) || data.uid == request.auth.uid) &&
        (!data.keys().hasAny(["authUid"]) || data.authUid == request.auth.uid) &&
        (!data.keys().hasAny(["userId"]) || data.userId == request.auth.uid) &&
        (!data.keys().hasAny(["linkedUserId"]) || data.linkedUserId == request.auth.uid) &&
        (!data.keys().hasAny(["accountUid"]) || data.accountUid == request.auth.uid) &&
        !data.keys().hasAny([
          "createdBy",
          "coachId",
          "coachUid",
          "coachIds",
          "ownerId",
          "ownerUid",
          "assignedBy",
          "sharedWith",
          "clubId",
          "clubIds",
          "isAdmin",
          "admin",
          "stripeCustomerId",
          "stripeSubscriptionId"
        ]) &&
        (!data.keys().hasAny(["hasActiveSubscription"]) || data.hasActiveSubscription != true);
    }

    function canCreateClient(clientId, data) {
      return isAdmin() ||
        safeSelfClientCreate(clientId, data) ||
        (
          hasCoachAccess() &&
          (
            (data.keys().hasAny(["createdBy"]) && data.createdBy == request.auth.uid) ||
            (data.keys().hasAny(["coachId"]) && data.coachId == request.auth.uid) ||
            uidInList(data, "coachIds") ||
            isSameClub(data)
          )
        );
    }

    function programAssignedToSelf(data) {
      return signedIn() && (
        (data.keys().hasAny(["clientId"]) && (
          data.clientId == request.auth.uid ||
          (
            currentUser().keys().hasAny(["linkedClientId"]) &&
            data.clientId == currentUser().linkedClientId
          )
        )) ||
        (data.keys().hasAny(["userId"]) && data.userId == request.auth.uid) ||
        (data.keys().hasAny(["ownerId"]) && data.ownerId == request.auth.uid) ||
        uidInList(data, "assignedTo") ||
        uidInList(data, "assignedClientIds")
      );
    }

    function canAccessProgram(data) {
      return isAdmin() || publicProgram(data) || coachOwnsRecord(data) || programAssignedToSelf(data);
    }

    function canCreateProgram(data) {
      return isAdmin() ||
        (
          hasCoachAccess() &&
          (
            (data.keys().hasAny(["createdBy"]) && data.createdBy == request.auth.uid) ||
            (data.keys().hasAny(["coachId"]) && data.coachId == request.auth.uid) ||
            isSameClub(data)
          )
        );
    }

    function canAccessSession(data) {
      return isAdmin() ||
        coachOwnsRecord(data) ||
        (
          signedIn() &&
          (
            (data.keys().hasAny(["clientId"]) && data.clientId == request.auth.uid) ||
            (data.keys().hasAny(["clientDocId"]) && (
              data.clientDocId == request.auth.uid ||
              (
                currentUser().keys().hasAny(["linkedClientId"]) &&
                data.clientDocId == currentUser().linkedClientId
              )
            )) ||
            (data.keys().hasAny(["userId"]) && data.userId == request.auth.uid)
          )
        );
    }

    function publicProgram(data) {
      return data.isActive != false && (
        data.visibility == "public" ||
        data.origine == "premium" ||
        data.source == "premium" ||
        data.isPremiumOnly == true
      );
    }

    function userSelfProtectedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "role",
        "isAdmin",
        "admin",
        "hasActiveSubscription",
        "subscriptionStatus",
        "stripeCustomerId",
        "stripeSubscriptionId",
        "trialStartedAt",
        "trialEndsAt",
        "linkedClientId",
        "emailVerified",
        "emailVerifiedAt",
        "emailVerificationRequired",
        "email",
        "emailLower",
        "accountType",
        "clubId",
        "clubRole",
        "accessViaClub",
        "packageKey",
        "packageTier",
        "onboardingPackage",
        "onboardingPackageTier",
        "requestedPackageKey",
        "requestedPackageTier",
        "clientLimit",
        "proLimit",
        "modules",
        "proAccess",
        "planType",
        "trialStatus",
        "trialDays",
        "appTrialUsed",
        "hasPurchasedCustomProgram",
        "premiumFirstClaimed",
        "firstPremiumClaimed",
        "premiumFirstClaimAt",
        "firstPremiumClaimAt"
      ]);
    }

    function canSyncAuthenticatedEmail() {
      return signedIn() &&
        request.auth.token.email is string &&
        request.resource.data.email == request.auth.token.email &&
        (
          !request.resource.data.keys().hasAny(["emailLower"]) ||
          request.resource.data.emailLower == request.auth.token.email
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email",
          "emailLower",
          "pendingEmailChange",
          "updatedAt"
        ]);
    }

    function canActivateVerifiedCoachTrial() {
      return signedIn() &&
        verifiedEmail() &&
        resource.data.role == "coach" &&
        resource.data.subscriptionStatus == "pending_verification" &&
        resource.data.emailVerificationRequired == true &&
        request.resource.data.role == "coach" &&
        request.resource.data.subscriptionStatus == "trialing" &&
        request.resource.data.trialStatus == "running" &&
        request.resource.data.emailVerificationRequired == true &&
        request.resource.data.emailVerified == true &&
        request.resource.data.hasActiveSubscription != true &&
        request.resource.data.trialStartedAt is timestamp &&
        request.resource.data.trialStartedAt <= request.time + duration.value(5, "m") &&
        request.resource.data.trialEndsAt is timestamp &&
        request.resource.data.trialEndsAt > request.time &&
        request.resource.data.trialEndsAt <= request.time + duration.value(30, "d") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "subscriptionStatus",
          "trialStatus",
          "trialStartedAt",
          "trialEndsAt",
          "trialDays",
          "onboardingPackage",
          "onboardingPackageTier",
          "packageKey",
          "packageTier",
          "clientLimit",
          "proLimit",
          "modules",
          "proAccess",
          "hasActiveSubscription",
          "emailVerified",
          "emailVerifiedAt",
          "updatedAt"
        ]);
    }

    function canSyncVerifiedEmail() {
      return signedIn() &&
        verifiedEmail() &&
        resource.data.emailVerificationRequired == true &&
        request.resource.data.emailVerificationRequired == true &&
        request.resource.data.emailVerified == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "emailVerified",
          "emailVerifiedAt",
          "updatedAt"
        ]);
    }

    function userRoleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]);
    }

    function safeSelfUserCreate(uid, data) {
      return isOwnUser(uid) &&
        data.role in ["particulier", "coach"] &&
        (!data.keys().hasAny(["hasActiveSubscription"]) || data.hasActiveSubscription != true) &&
        (!data.keys().hasAny(["isAdmin"]) || data.isAdmin != true) &&
        (!data.keys().hasAny(["admin"]) || data.admin != true) &&
        (!data.keys().hasAny(["stripeCustomerId"]) || data.stripeCustomerId == null) &&
        (!data.keys().hasAny(["stripeSubscriptionId"]) || data.stripeSubscriptionId == null) &&
        (
          (
            data.role == "particulier" &&
            (!data.keys().hasAny(["subscriptionStatus"]) || data.subscriptionStatus == "free") &&
            (!data.keys().hasAny(["accountType"]) || data.accountType == "") &&
            (!data.keys().hasAny(["clubId"]) || data.clubId == null) &&
            (!data.keys().hasAny(["clubRole"]) || data.clubRole == "")
          ) ||
          (
            data.role == "coach" &&
            data.accountType in ["pro", "club_owner"] &&
            (
              (data.accountType == "pro" && data.clubId == null && data.clubRole == "") ||
              (data.accountType == "club_owner" && data.clubId == uid && data.clubRole == "owner")
            ) &&
            (
              (
                data.subscriptionStatus == "pending_verification" &&
                data.emailVerificationRequired == true &&
                data.emailVerified == false &&
                !data.keys().hasAny(["trialStartedAt", "trialEndsAt"])
              ) ||
              (
                verifiedEmail() &&
                data.subscriptionStatus == "trialing" &&
                data.trialEndsAt is timestamp &&
                data.trialEndsAt <= request.time + duration.value(30, "d")
              )
            )
          )
        );
    }

    match /users/{uid} {
      allow create: if safeSelfUserCreate(uid, request.resource.data) || isAdmin() || (
        hasCoachAccess() &&
        request.resource.data.role == "particulier" &&
        request.resource.data.linkedClientId == uid &&
        request.resource.data.hasActiveSubscription != true &&
        !request.resource.data.keys().hasAny(["stripeCustomerId", "stripeSubscriptionId"]) &&
        !(
          request.resource.data.keys().hasAny(["subscriptionStatus"]) &&
          request.resource.data.subscriptionStatus in ["active", "trialing"]
        )
      );
      allow get: if isOwnUser(uid) || isAdmin() || (
        signedIn() && resource.data.role == "coach"
      );
      allow list: if isAdmin();
      allow update: if (isAdmin() && userRoleUnchanged()) ||
        (isOwnUser(uid) && (
          userSelfProtectedFieldsUnchanged() ||
          canActivateVerifiedCoachTrial() ||
          canSyncVerifiedEmail() ||
          canSyncAuthenticatedEmail()
        ));
      allow delete: if isAdmin();

      match /privacy/{document=**} {
        allow read, write: if isOwnUser(uid) || isAdmin();
      }

      match /measurements/{document=**} {
        allow read, write: if isOwnUser(uid) || isAdmin();
      }
    }

    match /conversations/{conversationId} {
      allow read: if canReadConversation(resource.data);
      allow create: if signedIn() &&
        canAccessConversation(request.resource.data.clientId) &&
        validConversationCreate(conversationId, request.resource.data);
      allow update: if signedIn() && validConversationUpdate(resource.data, request.resource.data);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
          canReadConversation(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          );
        allow create: if existsAfter(/databases/$(database)/documents/conversations/$(conversationId)) &&
          canReadConversation(
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data
          ) &&
          request.resource.data.keys().hasOnly(["text", "senderUid", "createdAt", "createdAtIso", "type"]) &&
          request.resource.data.keys().hasAll(["text", "senderUid", "createdAt", "createdAtIso", "type"]) &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.type == "text" &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 4000 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.createdAtIso is string;
        allow update, delete: if false;
      }
    }

    match /clients/{clientId} {
      allow read: if canAccessClient(clientId, resource.data);
      allow create: if canCreateClient(clientId, request.resource.data);
      allow update: if isAdmin() || (
        coachOwnsRecord(resource.data) && coachOwnsRecord(request.resource.data)
      ) || (
        clientIsOwnProfile(clientId, resource.data) &&
        clientIsOwnProfile(clientId, request.resource.data) &&
        clientSecurityFieldsUnchanged()
      );
      allow delete: if isAdmin() || coachOwnsRecord(resource.data);

      match /programmes/{document=**} {
        allow read, write: if canAccessClient(
          clientId,
          get(/databases/$(database)/documents/clients/$(clientId)).data
        );
      }

      match /measurements/{document=**} {
        allow read, write: if canAccessClient(
          clientId,
          get(/databases/$(database)/documents/clients/$(clientId)).data
        );
      }

      match /nutrition_assessments/{document=**} {
        allow read: if isAdmin() || (
          hasNutritionAccess() &&
          canAccessClient(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          )
        ) || (
          clientIsOwnProfile(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          ) &&
          resource.data.keys().hasAny(["clientShare"]) &&
          resource.data.clientShare is map &&
          resource.data.clientShare.keys().hasAny(["enabled"]) &&
          resource.data.clientShare.enabled == true
        );
        allow create, update, delete: if isAdmin() || (
          hasNutritionAccess() &&
          canAccessClient(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          )
        );
      }

      match /nutrition_feedback/{document=**} {
        allow read: if isAdmin() || clientIsOwnProfile(
          clientId,
          get(/databases/$(database)/documents/clients/$(clientId)).data
        ) || (
          hasNutritionAccess() &&
          canAccessClient(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          )
        );
        allow create: if isAdmin() || (
          clientIsOwnProfile(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          ) &&
          request.resource.data.type == "client"
        ) || (
          hasNutritionAccess() &&
          canAccessClient(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          ) &&
          request.resource.data.type == "coach"
        );
        allow update, delete: if isAdmin() || (
          clientIsOwnProfile(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          ) &&
          resource.data.type == "client" &&
          request.resource.data.type == "client"
        ) || (
          clientIsOwnProfile(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          ) &&
          resource.data.type == "coach" &&
          request.resource.data.type == "coach" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["clientReadAt", "clientReadAtIso"])
        ) || (
          hasNutritionAccess() &&
          canAccessClient(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          )
        );
      }

      match /nutrition_daily_logs/{dateKey} {
        allow read: if isAdmin() || clientIsOwnProfile(
          clientId,
          get(/databases/$(database)/documents/clients/$(clientId)).data
        ) || (
          hasNutritionAccess() &&
          canAccessClient(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          )
        );
        allow create, update: if (
          isAdmin() || clientIsOwnProfile(
            clientId,
            get(/databases/$(database)/documents/clients/$(clientId)).data
          )
        ) && request.resource.data.clientId == clientId && request.resource.data.dateKey == dateKey;
        allow delete: if isAdmin() || clientIsOwnProfile(
          clientId,
          get(/databases/$(database)/documents/clients/$(clientId)).data
        );
      }

      match /{subCollection}/{document=**} {
        allow read, write: if isAdmin();
      }
    }

    match /programmes/{programId} {
      allow read: if canAccessProgram(resource.data);
      allow create: if canCreateProgram(request.resource.data);
      allow update: if canAccessProgram(resource.data) && canAccessProgram(request.resource.data);
      allow delete: if isAdmin() || coachOwnsRecord(resource.data);

      match /{subCollection}/{document=**} {
        allow read: if canAccessProgram(
          get(/databases/$(database)/documents/programmes/$(programId)).data
        );
        allow write: if isAdmin() || coachOwnsRecord(
          get(/databases/$(database)/documents/programmes/$(programId)).data
        );
      }
    }

    match /sessions/{sessionId} {
      allow read: if canAccessSession(resource.data);
      allow create: if canAccessSession(request.resource.data);
      allow update: if canAccessSession(resource.data) && canAccessSession(request.resource.data);
      allow delete: if isAdmin() || coachOwnsRecord(resource.data);
    }

    match /coachDashboardSummaries/{summaryId} {
      allow read: if isAdmin() || (
        hasCoachAccess() &&
        resource.data.coachUid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
        hasCoachAccess() &&
        request.resource.data.coachUid == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /coachPageSummaries/{summaryId} {
      allow read: if isAdmin() || (
        hasCoachAccess() &&
        resource.data.coachUid == request.auth.uid
      );
      allow create, update: if isAdmin() || (
        hasCoachAccess() &&
        request.resource.data.coachUid == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    match /training/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /warmup/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /cooldown/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /ergometre/{exerciseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /coachs/{coachId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow write: if isAdmin() || isOwnUser(coachId);
    }

    match /clubs/{clubId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isClubOwner(clubId) || (isCoach() && currentUser().clubId == clubId);
      allow update: if isClubOwner(clubId);
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow create: if isClubOwner(clubId) || (
          isOwnUser(memberId) &&
          clubId == request.auth.uid &&
          request.resource.data.role == "owner"
        );
        allow read: if isClubOwner(clubId) || (isCoach() && currentUser().clubId == clubId);
        allow update, delete: if isClubOwner(clubId);
      }

      match /appointments/{appointmentId} {
        allow create, update, delete: if isClubOwner(clubId);
        allow read: if isClubOwner(clubId) || (
          isCoach() &&
          currentUser().clubId == clubId &&
          resource.data.coachUid == request.auth.uid
        );
      }
    }

    match /analytics_geo/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_daily/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_geo_daily/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /analytics_geo_hourly/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /contact_messages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /calendarSubscriptionTokens/{token} {
      allow read, write: if isAdmin();
    }

    match /coachCalendarSubscriptions/{coachId} {
      allow read, write: if isAdmin() || isOwnUser(coachId);
    }

    match /custom_program_orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /stripe_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /health/{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
